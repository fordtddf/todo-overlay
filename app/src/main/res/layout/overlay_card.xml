<?xml version="1.0" encoding="utf-8"?>
<!--
  解锁悬浮卡片。
  列表放在 MaxHeightScrollView 里：条目少时卡片自适应收缩，
  条目多时封顶在屏幕高度一半以内并可以上下滑动。
-->
<com.example.todooverlay.overlay.TouchObservingLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/overlay_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <!-- 今日完成进度：3/7 · 42% -->
        <TextView
            android:id="@+id/tv_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#8AB4F8"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/overlay_close"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!--
      代码调用 scrollTo 时系统通常不绘滚动条，所以这里：
      · scrollbars=vertical 明确启用
      · fadeScrollbars=false 常驻显示，不自动淡出
      · scrollbarStyle=insideOverlay 浮在内容上层，不挤占文字宽度
      · 配合 OverlayScroller 每帧 awakenScrollBars() 持续刷新
    -->
    <com.example.todooverlay.overlay.MaxHeightScrollView
        android:id="@+id/scroll_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarAlwaysDrawVerticalTrack="false"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbars="vertical">

        <!--
          ScrollView 只允许一个直接子节点，所以列表、折叠标题、折叠容器
          必须包在同一个外层 LinearLayout 里。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/container_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 逾期任务折叠区：默认隐藏，点击标题展开 -->
            <TextView
                android:id="@+id/tv_overdue_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="false"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_overdue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </com.example.todooverlay.overlay.MaxHeightScrollView>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:max="1000"
        android:progress="1000"
        android:progressDrawable="@drawable/progress_overlay" />

    <!-- 六级单词：每次弹窗换 5 个新词 -->
    <LinearLayout
        android:id="@+id/container_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF" />

        <TextView
            android:id="@+id/tv_words_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_words_title"
            android:textColor="#73FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 快速记一笔：点击后就地展开输入框 -->
    <TextView
        android:id="@+id/btn_quick_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/overlay_quick_add"
        android:textColor="#8AB4F8"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/et_quick_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#8AB4F8"
        android:hint="@string/overlay_quick_add_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#80FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

</com.example.todooverlay.overlay.TouchObservingLayout>
